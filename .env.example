# Copy this file to .env and fill in your details. Never commit .env.
# Gmail: turn on 2-step verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SENDER_NAME=Reminder Bot
# true = save emails to outputs/sent_emails instead of sending them
DRY_RUN=true
